@attribute [Authorize]
@page "/add-comment"
@rendermode InteractiveServer
@using ApiContracts
@using BlazorApp.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject ICommentService CommentService
@inject AuthenticationStateProvider AuthProvider

<h3>Add New Comment</h3>

@if (!authLoaded)
{
    <p>Checking login...</p>
}
else if (userId == 0)
{
    <p>Please log in before adding a comment.</p>
    <a href="/login">Go to Login</a>
}
else
{
    <p>Commenting as: @userName</p>

    <div>
        <label>Comment:</label>
        <textarea @bind="body"></textarea>
    </div>

    <br />

    <div>
        <label>Post ID:</label>
        <input type="number" @bind="postId" />
    </div>

    <br />

    <button @onclick="CreateComment">Add Comment</button>
}

<p>@message</p>

@code {
    private string body = "";
    private int postId = 3;
    private int userId = 0;
    private string userName = "";
    private string message = "";
    private bool authLoaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                userName = user.Identity.Name ?? "";

                int.TryParse(
                    user.FindFirst(ClaimTypes.NameIdentifier)?.Value,
                    out userId);
            }

            authLoaded = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CreateComment()
    {
        if (userId == 0)
        {
            message = "Please log in first.";
            return;
        }

        if (string.IsNullOrWhiteSpace(body))
        {
            message = "Please enter a comment.";
            return;
        }

        if (postId <= 0)
        {
            message = "Please enter a valid Post ID.";
            return;
        }

        try
        {
            var request = new CreateCommentDto
            {
                Body = body,
                UserId = userId,
                PostId = postId
            };

            await CommentService.AddCommentAsync(request);

            message = "Comment added successfully!";
            body = "";
        }
        catch (Exception ex)
        {
            message = "Error: " + ex.Message;
        }
    }
}
